# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع .env إلى المستودع.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://hadiyah:CHANGE_ME@localhost:5432/hadiyah_members
# مطلوب في الإنتاج: سلسلة عشوائية طويلة (openssl rand -hex 48)
SESSION_SECRET=
# خلف وكيل عكسي (Nginx/Caddy) بـ HTTPS اجعلها 1
TRUST_PROXY=0
# في الإنتاج اجعلها true (لا تعمل الجلسة إلا عبر HTTPS)
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
# مسار متصفح Chromium لتوليد PDF (يُكتشف تلقائيًا إن وُجد)
CHROME_PATH=
# اختياري: لإنشاء المدير الأول عبر npm run seed:admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
